rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // ADMINISTRADOR PRINCIPAL
    // ============================================================

    function isMasterAdmin() {

      return request.auth != null
        && request.auth.uid ==
           "3QlkmlndAXaGxErEpCL17Mun35E3";

    }


    // ============================================================
    // USUÁRIO LOGADO
    // ============================================================

    function isSignedIn() {

      return request.auth != null;

    }


    // ============================================================
    // PERFIL DO USUÁRIO
    // ============================================================

    function userData() {

      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;

    }


    // ============================================================
    // COLABORADOR ATIVO
    // ============================================================

    function isCollaborator() {

      return isSignedIn()
        && userData().role == "colaborador"
        && userData().active == true;

    }


    // ============================================================
    // USUÁRIOS
    // ============================================================

    match /users/{userId} {

      // ----------------------------------------------------------
      // LEITURA
      // ----------------------------------------------------------

      // ADMIN PRINCIPAL:
      // pode visualizar todos os usuários.
      //
      // COLABORADOR:
      // pode visualizar somente o próprio perfil.
      // ----------------------------------------------------------

      allow read: if isMasterAdmin()
        ||
        (
          isSignedIn()
          && request.auth.uid == userId
        );


      // ----------------------------------------------------------
      // CRIAÇÃO
      // ----------------------------------------------------------

      // Somente o administrador principal.
      // ----------------------------------------------------------

      allow create: if isMasterAdmin();


      // ----------------------------------------------------------
      // ALTERAÇÃO
      // ----------------------------------------------------------

      // Somente o administrador principal.
      // ----------------------------------------------------------

      allow update: if isMasterAdmin();


      // ----------------------------------------------------------
      // EXCLUSÃO
      // ----------------------------------------------------------

      // Somente o administrador principal.
      // ----------------------------------------------------------

      allow delete: if isMasterAdmin();

    }


    // ============================================================
    // LOTES
    // ============================================================

    match /lots/{lotId} {

      // ----------------------------------------------------------
      // LEITURA
      // ----------------------------------------------------------

      // ADMIN PRINCIPAL:
      // vê todos os lotes.
      //
      // COLABORADOR:
      // vê somente os lotes atribuídos a ele.
      // ----------------------------------------------------------

      allow read: if isMasterAdmin()
        ||
        (
          isCollaborator()
          &&
          resource.data.assignedTo ==
          request.auth.uid
        );


      // ----------------------------------------------------------
      // CRIAR LOTE
      // ----------------------------------------------------------

      // Somente o administrador principal.
      // ----------------------------------------------------------

      allow create: if isMasterAdmin();


      // ----------------------------------------------------------
      // ALTERAR LOTE
      // ----------------------------------------------------------

      // ADMIN PRINCIPAL:
      // pode alterar absolutamente qualquer campo.
      //
      // COLABORADOR:
      // pode alterar somente dados de produção
      // do lote que está atribuído a ele.
      // ----------------------------------------------------------

      allow update: if isMasterAdmin()
        ||
        (
          isCollaborator()
          &&
          resource.data.assignedTo ==
          request.auth.uid

          &&

          request.resource.data.name ==
          resource.data.name

          &&

          request.resource.data.os ==
          resource.data.os

          &&

          request.resource.data.clientName ==
          resource.data.clientName

          &&

          request.resource.data.weight ==
          resource.data.weight

          &&

          request.resource.data.entryDate ==
          resource.data.entryDate

          &&

          request.resource.data.programDate ==
          resource.data.programDate

          &&

          request.resource.data.assignedTo ==
          resource.data.assignedTo

          &&

          request.resource.data.createdBy ==
          resource.data.createdBy

          &&

          request.resource.data.createdAt ==
          resource.data.createdAt
        );


      // ----------------------------------------------------------
      // EXCLUSÃO
      // ----------------------------------------------------------

      // Somente o administrador principal.
      // ----------------------------------------------------------

      allow delete: if isMasterAdmin();

    }

  }

}
