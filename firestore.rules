rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // ADMINISTRADOR PRINCIPAL
    // ============================================================

    function isMasterAdmin() {
      return request.auth != null
        && request.auth.uid == "3QlkmlndAXaGxErEpCL17Mun35E3";
    }


    // ============================================================
    // USUÁRIO LOGADO
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }


    // ============================================================
    // DADOS DO USUÁRIO
    // ============================================================

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }


    // ============================================================
    // COLABORADOR ATIVO
    // ============================================================

    function isCollaborator() {
      return isSignedIn()
        && userData().role == "colaborador"
        && userData().active == true;
    }


    // ============================================================
    // USUÁRIOS
    // ============================================================

    match /users/{userId} {

      // Seu login pode ver todos.
      // Colaborador pode ver somente o próprio perfil.
      allow read: if isMasterAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
        );


      // Somente seu login pode criar usuários.
      allow create: if isMasterAdmin();


      // Somente seu login pode alterar usuários.
      allow update: if isMasterAdmin();


      // Somente seu login pode excluir usuários.
      allow delete: if isMasterAdmin();
    }


    // ============================================================
    // LOTES
    // ============================================================

    match /lots/{lotId} {

      // ----------------------------------------------------------
      // LEITURA
      // ----------------------------------------------------------
      //
      // ADMIN PRINCIPAL:
      // acesso a TODOS os lotes.
      //
      // COLABORADOR:
      // somente os lotes atribuídos a ele.
      // ----------------------------------------------------------

      allow read: if isMasterAdmin()
        || (
          isCollaborator()
          && resource.data.assignedTo == request.auth.uid
        );


      // ----------------------------------------------------------
      // CRIAR
      // ----------------------------------------------------------
      //
      // Somente administrador principal.
      // ----------------------------------------------------------

      allow create: if isMasterAdmin();


      // ----------------------------------------------------------
      // ALTERAR
      // ----------------------------------------------------------
      //
      // ADMIN PRINCIPAL:
      // pode alterar QUALQUER CAMPO de QUALQUER LOTE.
      //
      // COLABORADOR:
      // pode registrar produção somente no lote atribuído.
      // ----------------------------------------------------------

      allow update: if isMasterAdmin()
        || (
          isCollaborator()
          && resource.data.assignedTo == request.auth.uid

          // Não pode trocar o responsável
          && request.resource.data.assignedTo ==
             resource.data.assignedTo

          // Não pode alterar dados cadastrais
          && request.resource.data.name ==
             resource.data.name

          && request.resource.data.os ==
             resource.data.os

          && request.resource.data.clientName ==
             resource.data.clientName

          && request.resource.data.weight ==
             resource.data.weight

          && request.resource.data.entryDate ==
             resource.data.entryDate

          && request.resource.data.programDate ==
             resource.data.programDate

          && request.resource.data.createdBy ==
             resource.data.createdBy

          && request.resource.data.createdAt ==
             resource.data.createdAt
        );


      // ----------------------------------------------------------
      // EXCLUIR
      // ----------------------------------------------------------

      allow delete: if isMasterAdmin();
    }

  }
}
