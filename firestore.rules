rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userDoc());
    }

    function isAdmin() {
      return hasProfile()
        && get(userDoc()).data.role == "admin"
        && get(userDoc()).data.active == true;
    }

    function isCollaborator() {
      return hasProfile()
        && get(userDoc()).data.role == "colaborador"
        && get(userDoc()).data.active == true;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    
    match /lots/{lotId} {
      // Administradores podem ler/criar/editar/excluir qualquer lote.
      allow read, create, update, delete: if isAdmin();

      // Colaborador só pode ler o lote que está atribuído ao seu Auth UID.
      // A consulta do Kanban usa where("assignedTo", "==", request.auth.uid).
      allow read: if signedIn()
        && isCollaborator()
        && resource.data.assignedTo == request.auth.uid;

      // Colaborador pode atualizar o próprio lote, mantendo a atribuição.
      allow update: if signedIn()
        && isCollaborator()
        && resource.data.assignedTo == request.auth.uid
        && request.resource.data.assignedTo == request.auth.uid;

      // Colaborador não pode criar/excluir lotes.
      allow create, delete: if false;
    }

  }
}
