rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ========================================================
    // USUÁRIO LOGADO
    // ========================================================

    function isSignedIn() {

      return request.auth != null;

    }

    // ========================================================
    // DADOS DO USUÁRIO LOGADO
    // ========================================================

    function userData() {

      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;

    }

    // ========================================================
    // ADMINISTRADOR
    // ========================================================

    function isAdmin() {

      return isSignedIn()
        && userData().role == "admin";

    }

    // ========================================================
    // COLABORADOR ATIVO
    // ========================================================

    function isCollaborator() {

      return isSignedIn()
        && userData().role == "colaborador"
        && userData().active == true;

    }

    // ========================================================
    // USUÁRIOS
    // ========================================================

    match /users/{userId} {

      // ------------------------------------------------------
      // LEITURA
      // ------------------------------------------------------

      // Admin:
      // pode visualizar todos os usuários.
      //
      // Colaborador:
      // pode visualizar somente o próprio perfil.
      // ------------------------------------------------------

      allow read: if isSignedIn()
        && (
          isAdmin()
          ||
          request.auth.uid == userId
        );

      // ------------------------------------------------------
      // CRIAR
      // ------------------------------------------------------

      // Somente administrador.
      // ------------------------------------------------------

      allow create: if isAdmin();

      // ------------------------------------------------------
      // ALTERAR
      // ------------------------------------------------------

      // Somente administrador.
      // ------------------------------------------------------

      allow update: if isAdmin();

      // ------------------------------------------------------
      // EXCLUIR
      // ------------------------------------------------------

      // Somente administrador.
      // ------------------------------------------------------

      allow delete: if isAdmin();
    }

    // ========================================================
    // LOTES
    // ========================================================

    match /lots/{lotId} {

      // ------------------------------------------------------
      // LEITURA
      // ------------------------------------------------------

      // ADMIN:
      // vê todos os lotes.
      //
      // COLABORADOR:
      // vê somente lotes atribuídos a ele.
      // ------------------------------------------------------

      allow read: if isSignedIn()
        && (
          isAdmin()
          ||
          (
            isCollaborator()
            &&
            resource.data.assignedTo ==
            request.auth.uid
          )
        );

      // ------------------------------------------------------
      // CRIAR LOTE
      // ------------------------------------------------------

      // Somente administrador.
      // ------------------------------------------------------

      allow create: if isAdmin();

      // ------------------------------------------------------
      // ALTERAR LOTE
      // ------------------------------------------------------

      // ADMIN:
      // pode alterar qualquer lote.
      //
      // COLABORADOR:
      // pode alterar somente produção
      // do lote que está atribuído a ele.
      // ------------------------------------------------------

      allow update: if isAdmin()
        ||
        (
          isCollaborator()
          &&
          resource.data.assignedTo ==
          request.auth.uid
          &&
          request.resource.data.assignedTo ==
          request.auth.uid
          &&
          request.resource.data.name ==
          resource.data.name
          &&
          request.resource.data.os ==
          resource.data.os
          &&
          request.resource.data.clientName ==
          resource.data.clientName
          &&
          request.resource.data.weight ==
          resource.data.weight
          &&
          request.resource.data.entryDate ==
          resource.data.entryDate
          &&
          request.resource.data.programDate ==
          resource.data.programDate
          &&
          request.resource.data.createdBy ==
          resource.data.createdBy
          &&
          request.resource.data.createdAt ==
          resource.data.createdAt
        );

      // ------------------------------------------------------
      // EXCLUIR
      // ------------------------------------------------------

      // Somente administrador.
      // ------------------------------------------------------

      allow delete: if isAdmin();
    }

  }
}
