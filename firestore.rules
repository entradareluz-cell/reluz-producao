rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // AUTENTICAÇÃO E PERFIL
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(currentUserPath());
    }

    function isAdmin() {
      return hasUserProfile()
        && get(currentUserPath()).data.role == "admin"
        && get(currentUserPath()).data.active != false;
    }

    function isCollaborator() {
      return hasUserProfile()
        && get(currentUserPath()).data.role == "colaborador"
        && get(currentUserPath()).data.active == true;
    }

    // ============================================================
    // USUÁRIOS
    // ============================================================

    match /users/{userId} {

      // Admin vê todos; usuário comum vê somente o próprio perfil.
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);

      // Somente administradores podem criar/alterar/excluir perfis.
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // LOTES
    // ============================================================

    match /lots/{lotId} {

      // Admin vê todos.
      // Colaborador só pode consultar lotes atribuídos ao próprio UID.
      allow read: if isAdmin()
        || (
          isCollaborator()
          && resource.data.assignedTo == request.auth.uid
        );

      // Somente administrador cadastra lotes.
      allow create: if isAdmin();

      // Admin pode alterar qualquer campo.
      //
      // Colaborador pode alterar somente os campos usados
      // pelo registro de produção.
      allow update: if isAdmin()
        || (
          isCollaborator()
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 "producedWeight",
                 "status",
                 "updatedAt",
                 "lastObservation",
                 "productionLogs"
               ])
        );

      // Exclusão somente pelo administrador.
      allow delete: if isAdmin();
    }
  }
}
