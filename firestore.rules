rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // ADMINISTRADOR PRINCIPAL
    // =========================================================
    //
    // SOMENTE ESTE UID possui acesso administrativo completo.
    //
    // UID:
    // 3QlkmlndAXaGxErEpCL17Mun35E3
    //
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn()
        && request.auth.uid == "3QlkmlndAXaGxErEpCL17Mun35E3";
    }

    // =========================================================
    // COLABORADOR ATIVO
    // =========================================================

    function isCollaborator() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "colaborador"
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true;
    }

    // =========================================================
    // USUÁRIOS
    // =========================================================

    match /users/{userId} {

      // ADMIN:
      // Pode ler todos os usuários.
      //
      // COLABORADOR:
      // Pode ler somente o próprio perfil.
      //
      allow read: if
        isMasterAdmin()
        ||
        (
          isSignedIn()
          && request.auth.uid == userId
        );

      // Somente o administrador principal pode criar usuários.
      allow create: if isMasterAdmin();

      // Somente o administrador principal pode alterar usuários.
      allow update: if isMasterAdmin();

      // Somente o administrador principal pode excluir usuários.
      allow delete: if isMasterAdmin();
    }

    // =========================================================
    // LOTES
    // =========================================================

    match /lots/{lotId} {

      // =======================================================
      // LEITURA
      // =======================================================
      //
      // ADMIN:
      // vê todos os lotes.
      //
      // COLABORADOR:
      // vê somente lotes atribuídos a ele.
      //
      allow read: if
        isMasterAdmin()
        ||
        (
          isCollaborator()
          &&
          resource.data.assignedTo == request.auth.uid
        );

      // =======================================================
      // CRIAR LOTE
      // =======================================================
      //
      // Somente administrador principal.
      //
      allow create: if isMasterAdmin();

      // =======================================================
      // ALTERAR LOTE
      // =======================================================
      //
      // ADMIN:
      // pode alterar QUALQUER campo de QUALQUER lote.
      //
      // COLABORADOR:
      // pode registrar produção somente no lote atribuído.
      //
      allow update: if
        isMasterAdmin()
        ||
        (
          isCollaborator()

          &&

          resource.data.assignedTo == request.auth.uid

          &&

          request.resource.data.assignedTo == request.auth.uid

          &&

          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "producedWeight",
              "status",
              "updatedAt",
              "lastObservation",
              "productionLogs"
            ])

          &&

          request.resource.data.producedWeight >=
            resource.data.producedWeight

          &&

          request.resource.data.producedWeight <=
            request.resource.data.weight + 0.0001
        );

      // =======================================================
      // EXCLUIR
      // =======================================================
      //
      // Somente administrador principal.
      //
      allow delete: if isMasterAdmin();
    }

    // =========================================================
    // NEGAR TODO O RESTANTE
    // =========================================================
    //
    // Tudo que não estiver explicitamente permitido acima
    // continua bloqueado pelo Firestore.
    //
  }
}
