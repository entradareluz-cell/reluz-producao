rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userDoc());
    }

    function isAdmin() {
      return hasProfile()
        && get(userDoc()).data.role == "admin"
        && get(userDoc()).data.active == true;
    }

    function isCollaborator() {
      return hasProfile()
        && get(userDoc()).data.role == "colaborador"
        && get(userDoc()).data.active == true;
    }

    match /users/{userId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
        );

      allow create, update, delete: if isAdmin();
    }

    match /lots/{lotId} {

      // ADMINISTRADOR:
      // acesso completo e edição de TODOS os campos do lote:
      // nome, OS, peso, datas, cliente, colaborador, status,
      // observações e demais campos.
      allow read, create, update, delete: if isAdmin();

      // COLABORADOR:
      // somente lotes atribuídos ao próprio UID.
      allow read: if isCollaborator()
        && resource.data.assignedTo == request.auth.uid;

      // COLABORADOR:
      // somente campos operacionais de produção.
      // Não pode alterar o responsável nem dados administrativos.
      allow update: if isCollaborator()
        && resource.data.assignedTo == request.auth.uid
        && request.resource.data.assignedTo == resource.data.assignedTo
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "producedWeight",
            "status",
            "updatedAt",
            "lastObservation",
            "productionLogs"
          ]);
    }
  }
}
