rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ========================================================
    // ADMINISTRADOR PRINCIPAL
    // ========================================================

    function isMasterAdmin() {

      return request.auth != null
        && request.auth.uid ==
           "3QlkmlndAXaGxErEpCL17Mun35E3";

    }


    // ========================================================
    // USUÁRIO LOGADO
    // ========================================================

    function isSignedIn() {

      return request.auth != null;

    }


    // ========================================================
    // DADOS DO USUÁRIO
    // ========================================================

    function userData() {

      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;

    }


    // ========================================================
    // ADMIN
    // ========================================================

    function isAdmin() {

      return isMasterAdmin();

    }


    // ========================================================
    // COLABORADOR ATIVO
    // ========================================================

    function isCollaborator() {

      return isSignedIn()
        && userData().role == "colaborador"
        && userData().active == true;

    }


    // ========================================================
    // USUÁRIOS
    // ========================================================

    match /users/{userId} {

      // ------------------------------------------------------
      // LEITURA
      // ------------------------------------------------------

      // ADMIN:
      // pode visualizar todos os usuários.
      //
      // USUÁRIO:
      // pode visualizar somente seu próprio perfil.

      allow read: if
        isAdmin()
        ||
        (
          isSignedIn()
          &&
          request.auth.uid == userId
        );


      // ------------------------------------------------------
      // CRIAR
      // ------------------------------------------------------

      // Somente o administrador principal.

      allow create: if isAdmin();


      // ------------------------------------------------------
      // ALTERAR
      // ------------------------------------------------------

      // Somente o administrador principal.

      allow update: if isAdmin();


      // ------------------------------------------------------
      // EXCLUIR
      // ------------------------------------------------------

      // Somente o administrador principal.

      allow delete: if isAdmin();

    }


    // ========================================================
    // LOTES
    // ========================================================

    match /lots/{lotId} {

      // ------------------------------------------------------
      // LEITURA
      // ------------------------------------------------------

      // ADMIN:
      // vê todos os lotes.
      //
      // COLABORADOR:
      // vê somente os lotes atribuídos a ele.

      allow read: if
        isAdmin()
        ||
        (
          isCollaborator()
          &&
          resource.data.assignedTo ==
          request.auth.uid
        );


      // ------------------------------------------------------
      // CRIAR LOTE
      // ------------------------------------------------------

      // Somente administrador.

      allow create: if isAdmin();


      // ------------------------------------------------------
      // ALTERAR LOTE
      // ------------------------------------------------------

      // ADMIN:
      // pode alterar qualquer campo do lote.
      //
      // COLABORADOR:
      // somente campos relacionados à produção.
      //
      // O colaborador não pode:
      // - mudar nome
      // - mudar OS
      // - mudar cliente
      // - mudar peso
      // - mudar datas
      // - mudar responsável
      // - mudar quem criou o lote
      // - mudar data de criação

      allow update: if
        isAdmin()
        ||
        (
          isCollaborator()

          &&

          resource.data.assignedTo ==
          request.auth.uid

          &&

          request.resource.data.assignedTo ==
          request.auth.uid

          &&

          request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            "producedWeight",
            "status",
            "updatedAt",
            "lastObservation",
            "productionLogs"
          ])

          &&

          request.resource.data.name ==
          resource.data.name

          &&

          request.resource.data.os ==
          resource.data.os

          &&

          request.resource.data.clientName ==
          resource.data.clientName

          &&

          request.resource.data.weight ==
          resource.data.weight

          &&

          request.resource.data.entryDate ==
          resource.data.entryDate

          &&

          request.resource.data.programDate ==
          resource.data.programDate

          &&

          request.resource.data.createdBy ==
          resource.data.createdBy

          &&

          request.resource.data.createdAt ==
          resource.data.createdAt

        );


      // ------------------------------------------------------
      // EXCLUIR
      // ------------------------------------------------------

      // Somente administrador.

      allow delete: if isAdmin();

    }

  }

}
