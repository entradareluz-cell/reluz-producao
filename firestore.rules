rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USUÁRIOS
    // ============================================================

    match /users/{userId} {

      // Usuário autenticado pode consultar seu próprio perfil.
      // Administrador pode consultar todos os usuários.
      allow read: if request.auth != null &&
        (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            in ['admin', 'administrador', 'administrator']
        );

      // Somente administrador pode criar, editar ou excluir usuários.
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'administrador', 'administrator'];
    }


    // ============================================================
    // LOTES
    // ============================================================

    match /lots/{lotId} {

      // ==========================================================
      // ADMINISTRADOR
      // ==========================================================

      // Administrador pode visualizar todos os lotes.
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'administrador', 'administrator'];

      // Administrador pode criar, editar e excluir lotes.
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'administrador', 'administrator'];


      // ==========================================================
      // COLABORADOR
      // ==========================================================

      // Colaborador pode visualizar somente os lotes atribuídos a ele.
      allow read: if request.auth != null &&
        resource.data.assignedTo == request.auth.uid;


      // Colaborador pode atualizar somente seus próprios lotes.
      //
      // A regra permite registrar produção e atualizar os campos
      // necessários do lote, mas não permite que o colaborador
      // troque o responsável pelo lote.
      allow update: if request.auth != null &&
        resource.data.assignedTo == request.auth.uid &&
        request.resource.data.assignedTo == resource.data.assignedTo;


      // Colaborador NÃO pode criar lotes.
      // Colaborador NÃO pode excluir lotes.
    }


    // ============================================================
    // NEGAR QUALQUER OUTRA COLEÇÃO
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
