rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(userDoc())
        && get(userDoc()).data.role == "admin"
        && get(userDoc()).data.active == true;
    }

    match /users/{userId} {
      // Cada usuário pode ler seu próprio perfil.
      allow read: if signedIn() && request.auth.uid == userId;
      // Administrador gerencia todos os perfis.
      allow read, create, update, delete: if isAdmin();
    }

    match /lots/{lotId} {
      // Administrador tem acesso total.
      allow read, create, update, delete: if isAdmin();

      // Colaborador autenticado pode consultar somente lotes atribuídos
      // ao UID do Firebase. Não depende da coleção users para evitar
      // permission-denied antes da consulta.
      allow read: if signedIn()
        && resource.data.assignedTo == request.auth.uid;

      // Colaborador pode atualizar seu próprio lote, mas não pode trocar
      // o responsável pelo lote.
      allow update: if signedIn()
        && resource.data.assignedTo == request.auth.uid
        && request.resource.data.assignedTo == request.auth.uid;

      // Somente administrador cria/exclui.
      allow create, delete: if isAdmin();
    }
  }
}
